// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Category {
    id            Int           @id @default(autoincrement())
    name          String
    slug          String
    createdAt     Timestamp(3)  @default(now())
    quizzes       Quiz[]
    subCategories SubCategory[]

    @@unique([name])
    @@unique([slug])
    @@index([createdAt])
    @@index([slug])
    @@map("Category")
  }

  model Horoscope {
    id          Int                 @id @default(autoincrement())
    zodiacSign  pg.enum(ZodiacSign)
    date        Timestamp(3)
    description String
    luckyColor  String?
    luckyNumber Int?
    mood        String?
    createdAt   Timestamp(3)        @default(now())
    updatedAt   Timestamp(3)

    @@unique([zodiacSign, date])
    @@index([date])
    @@map("Horoscope")
  }

  model PastEvent {
    id          Int                    @id @default(autoincrement())
    month       Int
    day         Int
    year        Int
    title       String
    slug        String
    description String
    category    pg.enum(EventCategory)
    tags        String[]?              @noCheck(elementNotNull)
    sourceUrls  String[]?              @noCheck(elementNotNull)
    metadata    Jsonb?
    isPublished Boolean                @default(true)
    createdAt   Timestamp(3)           @default(now())
    updatedAt   Timestamp(3)
    eventDate   Timestamp(3)?

    @@unique([month, day, year, slug])
    @@index([category])
    @@index([eventDate])
    @@index([month, day, category])
    @@index([month, day])
    @@index([slug])
    @@map("PastEvent")
  }

  model SubCategory {
    id         Int          @id @default(autoincrement())
    name       String
    slug       String
    createdAt  Timestamp(3) @default(now())
    categoryId Int
    quizzes    Quiz[]
    category   Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    @@unique([categoryId, name])
    @@index([categoryId])
    @@index([slug])
    @@map("SubCategory")
  }

  model Quiz {
    id                  String                  @id
    quizPageTitle       String
    quizPageDescription String
    difficulty          pg.enum(QuizDifficulty)
    title               String
    description         String
    slug                String
    isPublished         Boolean                 @default(false)
    publishedAt         Timestamp(3)?
    views               Int                     @default(0)
    categoryId          Int?
    createdAt           Timestamp(3)            @default(now())
    updatedAt           Timestamp(3)
    subCategoryId       Int?
    questions           Question[]
    quizTags            QuizTag[]
    category            Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
    subCategory         SubCategory?            @relation(fields: [subCategoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)

    @@unique([quizPageTitle])
    @@unique([slug])
    @@index([createdAt])
    @@index([difficulty])
    @@index([isPublished])
    @@index([slug])
    @@map("Quiz")
  }

  model Question {
    id           String       @id
    quizId       String
    text         String
    options      String[]?    @noCheck(elementNotNull)
    correctIndex Int
    explanation  String?
    createdAt    Timestamp(3) @default(now())
    quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([quizId])
    @@map("Question")
  }

  model Tag {
    id        Int          @id @default(autoincrement())
    name      String
    createdAt Timestamp(3) @default(now())
    quizTags  QuizTag[]

    @@unique([name])
    @@index([name])
    @@map("Tag")
  }

  model QuizTag {
    quizId String
    tagId  Int
    quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@id([quizId, tagId])
    @@index([quizId])
    @@map("QuizTag")
  }

  native_enum EventCategory {
    war = "war"
    discovery = "discovery"
    politics = "politics"
    science = "science"
    art = "art"
    sports = "sports"
    technology = "technology"
    medicine = "medicine"
    exploration = "exploration"
    literature = "literature"
    music = "music"
    economy = "economy"
    religion = "religion"
    disaster = "disaster"
    revolution = "revolution"
    invention = "invention"
  }

  native_enum QuizDifficulty {
    easy = "easy"
    medium = "medium"
    hard = "hard"
  }

  native_enum ZodiacSign {
    ARIES = "ARIES"
    TAURUS = "TAURUS"
    GEMINI = "GEMINI"
    CANCER = "CANCER"
    LEO = "LEO"
    VIRGO = "VIRGO"
    LIBRA = "LIBRA"
    SCORPIO = "SCORPIO"
    SAGITTARIUS = "SAGITTARIUS"
    CAPRICORN = "CAPRICORN"
    AQUARIUS = "AQUARIUS"
    PISCES = "PISCES"
  }
}
